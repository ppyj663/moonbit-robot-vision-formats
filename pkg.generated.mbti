// Errors
pub(all) suberror CsvError {
  EmptyRow
  UnterminatedQuote(Int)
  UnexpectedQuote(Int)
  InvalidColumnCount(Int, Int, Int)
} derive(Eq, @debug.Debug)

pub(all) suberror VisionFormatError {
  EmptyInput
  MissingField(String)
  InvalidNumber(String)
  InvalidRow(String)
  InvalidShape(String)
  OutOfOrder(String)
} derive(Eq, @debug.Debug)

// Types and methods
pub(all) struct Annotation {
  stamp : Stamp
  frame_id : String
  label : String
  bbox : BoundingBox
  confidence : Double
} derive(ToJson, @debug.Debug)

pub(all) struct BenchmarkResult {
  name : String
  rows : Int
  iterations : Int
  elapsed_ns : Int64
  rows_per_second : Double
  checksum : Int64
} derive(ToJson, @debug.Debug)

pub(all) struct BoundingBox {
  x : Double
  y : Double
  width : Double
  height : Double
} derive(ToJson, @debug.Debug)
pub fn BoundingBox::area(Self) -> Double
pub fn BoundingBox::bottom(Self) -> Double
pub fn BoundingBox::intersection_area(Self, Self) -> Double
pub fn BoundingBox::iou(Self, Self) -> Double
pub fn BoundingBox::is_inside_image(Self, Int, Int) -> Bool
pub fn BoundingBox::right(Self) -> Double

pub(all) struct CameraIntrinsics {
  width : Int
  height : Int
  distortion_model : String
  k : Array[Double]
  d : Array[Double]
  r : Array[Double]
  p : Array[Double]
} derive(ToJson, @debug.Debug)
pub fn CameraIntrinsics::aspect_ratio(Self) -> Double raise VisionFormatError
pub fn CameraIntrinsics::has_identity_rectification(Self, Double) -> Bool
pub fn CameraIntrinsics::normalize_pixel(Self, PixelPoint) -> NormalizedPoint raise VisionFormatError
pub fn CameraIntrinsics::principal_point(Self) -> PixelPoint raise VisionFormatError
pub fn CameraIntrinsics::project_normalized(Self, NormalizedPoint) -> PixelPoint raise VisionFormatError

pub(all) struct CsvOptions {
  delimiter : Char
  trim_fields : Bool
  allow_comments : Bool
} derive(Eq, @debug.Debug)

pub(all) struct DatasetManifest {
  name : String
  root : String
  image_index : String
  camera_info : String?
  trajectory : String?
  depth_metadata : String?
  annotations : String?
} derive(Eq, ToJson, @debug.Debug)
pub fn DatasetManifest::required_files(Self) -> Array[String]
pub fn DatasetManifest::to_manifest_csv(Self) -> String
pub fn DatasetManifest::to_markdown(Self) -> String

pub(all) struct DatasetQualityReport {
  issues : Array[QualityIssue]
} derive(Eq, ToJson, @debug.Debug)
pub fn DatasetQualityReport::is_clean(Self) -> Bool
pub fn DatasetQualityReport::summary(Self) -> String

pub(all) struct DepthMetadata {
  stamp : Stamp
  frame_id : String
  width : Int
  height : Int
  encoding : String
  unit : String
  min_depth : Double
  max_depth : Double
} derive(ToJson, @debug.Debug)

pub(all) struct DistortedPoint {
  x : Double
  y : Double
} derive(ToJson, @debug.Debug)

pub(all) struct DistortionCoefficients {
  k1 : Double
  k2 : Double
  p1 : Double
  p2 : Double
  k3 : Double
} derive(ToJson, @debug.Debug)

pub(all) enum FieldKind {
  IntField
  FloatField
  StringField
  StampField
  PathField
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct FieldSpec {
  name : String
  kind : FieldKind
  required : Bool
  note : String
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct FormatSpec {
  name : String
  media_type : String
  fields : Array[FieldSpec]
  description : String
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct ImageFrameRef {
  stamp : Stamp
  frame_id : String
  path : String
} derive(Eq, ToJson, @debug.Debug)

pub(all) enum IssueSeverity {
  Info
  Warning
  Error
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct NormalizedPoint {
  x : Double
  y : Double
} derive(ToJson, @debug.Debug)

